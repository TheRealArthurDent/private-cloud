# Keys of /etc/docker/paperless/.env, which infrastructure's secrets role renders from KeePass. No values here.
# Django's secret key: signs sessions and tokens. Changing it logs everyone out.
PAPERLESS_SECRET_KEY=
# Password of the database user paperless; Postgres sets it on the first start only.
PAPERLESS_DB_PASSWORD=
# Password of the user "admin", created on the first start only.
PAPERLESS_ADMIN_PASSWORD=
